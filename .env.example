# Server-only URL used by Next.js rewrites. Do not prefix this with NEXT_PUBLIC_.
# Use the deployed Lambda Function URL without a trailing slash.
SIGNINGAPP_API_URL=https://example.lambda-url.region.on.aws

# Origins the browser may fetch document bytes from, comma separated.
#
# Document previews and archive retrievals are issued by the API but point at
# object storage, and the browser fetches those bytes directly. Every origin
# used must be listed here or the Content-Security-Policy in `proxy.ts` will
# block the fetch, and the viewer will report that the document could not be
# loaded. Only the origin is used; any path is ignored.
SIGNINGAPP_STORAGE_ORIGINS=https://api.cloudinary.com,https://res.cloudinary.com
